{
  "name": "performance-testing-tools",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "predev": "npm run generate",
    "build": "npm run generate && astro build",
    "generate": "node --experimental-strip-types scripts/generate-content.mjs",
    "preview": "astro preview",
    "pretest": "npm run generate",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "typecheck": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@astrojs/sitemap": "3.5.1",
    "@fontsource-variable/geist": "5.2.6",
    "@fontsource-variable/geist-mono": "5.2.6",
    "astro": "5.15.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.4",
    "@playwright/test": "1.55.0",
    "@tailwindcss/vite": "4.1.13",
    "@types/node": "24.5.2",
    "eslint": "9.36.0",
    "prettier": "3.6.2",
    "prettier-plugin-astro": "0.14.1",
    "sharp": "0.34.3",
    "tailwindcss": "4.1.13",
    "typescript": "5.9.2",
    "typescript-eslint": "8.44.0",
    "vitest": "3.2.4"
  }
}
