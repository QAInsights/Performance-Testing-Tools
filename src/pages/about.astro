---
import ConsoleLayout from '../layouts/ConsoleLayout.astro';
import LoadProfile from '../components/LoadProfile.astro';
import Footer from '../components/Footer.astro';
import { datasetLastVerified, tools } from '../data/tools';
import { siteUrl } from '../lib/urls';
import { aboutDescription, aboutTitle } from '../lib/pageMeta';
const archetypes = [
  ['Ramp', 'Gradual rise for protocol/API-oriented tools.', 'ghz'],
  [
    'Step',
    'Staged plateaus common for enterprise suites.',
    'loadrunner-enterprise',
  ],
  ['Spike', 'Concentrated peak common for micro-benchmark CLIs.', 'wrk'],
  [
    'Soak',
    'Sustained oscillating load common for open-source engines.',
    'locust',
  ],
  [
    'Burst',
    'Repeated bursts common for cloud/commercial services.',
    'blazemeter',
  ],
] as const;
---

<ConsoleLayout title={aboutTitle()} description={aboutDescription()}>
  <main class="about-page">
    <nav class="breadcrumbs mono">
      <a href={siteUrl()}>← Directory</a><span>/</span><strong>About</strong>
    </nav>
    <header>
      <p class="eyebrow">FIELD NOTES / QAINSIGHTS</p><h1>
        A living map of performance tools.
      </h1><p class="lead">
        Performance Testing Tools is a dense, practical directory for engineers
        choosing tools for load, stress, protocol, and performance testing.
      </p>
    </header>
    <div class="about-grid">
      <article class="panel about-card">
        <h2>How to read the directory</h2><p>
          The original PerformanceTestingTools diagram used a legend to call out
          the author's personal picks and generally recommended tools. This
          directory keeps that signal visible: <b class="amber"
            >♥ personal pick</b
          > marks a personal recommendation, while <b class="cyan"
            >✓ general pick</b
          > marks a broadly useful choice.
        </p><p>
          Mini load profiles are deterministic visual fingerprints, not measured
          benchmarks. They are generated from each tool's catalog attributes,
          not measured performance.
        </p><h3>Profile archetypes</h3><div class="archetype-list">
          {
            archetypes.map(([name, description, slug]) => {
              const example = tools.find((tool) => tool.slug === slug);
              return (
                example && (
                  <div class="archetype">
                    <>
                      <LoadProfile tool={example} width={150} height={42} />
                      <div>
                        <>
                          <b>{name}</b>
                          <span>{description}</span>
                        </>
                      </div>
                    </>
                  </div>
                )
              );
            })
          }
        </div>
      </article><article class="panel about-card">
        <h2>Maintained with evidence</h2><p>
          Tool records include official links, ownership, licensing, deployment,
          protocols, and lifecycle status where available. Renamed and
          discontinued products remain visible so historical references are not
          silently lost.
        </p><p class="mono small">
          Last shared verification: {datasetLastVerified}
        </p>
        <p>
          Machine-readable catalogs: <a href={siteUrl('llms.txt')}>llms.txt</a> and
          <a href={siteUrl('llms-full.txt')}>llms-full.txt</a>.
        </p>
      </article>
    </div>
    <section class="submit panel">
      <div>
        <p class="eyebrow">SEE SOMETHING MISSING?</p><h2>
          Submit a tool or correction
        </h2>
      </div><a
        class="button button--amber"
        href="https://github.com/QAInsights/Performance-Testing-Tools/issues/new?title=Tool%20submission%3A%20&body=Tool%20name%3A%20%0AOfficial%20URL%3A%20%0AWhat%20should%20be%20added%20or%20corrected%3F%20%0A"
        target="_blank"
        rel="noreferrer">Open GitHub issue ↗</a
      >
    </section>
    <Footer />
  </main>
</ConsoleLayout>
<style>
  .about-page {
    max-width: 1100px;
    margin: 0 auto;
    padding: 44px 28px 80px;
  }
  .breadcrumbs {
    display: flex;
    gap: 10px;
    color: var(--color-surface-300);
    font-size: 13px;
    margin-bottom: 32px;
  }
  .breadcrumbs a {
    color: var(--color-teal-300);
    text-decoration: none;
  }
  .breadcrumbs a:hover {
    color: var(--color-amber-400);
  }
  .about-page h1 {
    max-width: 820px;
    font-size: clamp(38px, 6vw, 76px);
    line-height: 1.05;
    letter-spacing: -0.05em;
    margin: 12px 0 20px;
    background: linear-gradient(
      120deg,
      var(--color-surface-100) 0%,
      var(--color-teal-300) 30%,
      var(--color-amber-400) 65%,
      var(--color-cyan-500) 85%,
      var(--color-surface-100) 100%
    );
    background-size: 200% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    color: transparent;
    animation: headingGradient 7s linear infinite;
  }
  @keyframes headingGradient {
    0% {
      background-position: 0% center;
    }
    100% {
      background-position: 200% center;
    }
  }
  .lead {
    max-width: 780px;
    font-size: 21px;
    line-height: 1.6;
    color: var(--color-surface-300);
    margin: 0;
  }
  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px;
    margin-top: 40px;
    margin-bottom: 32px;
  }
  .about-card {
    padding: 32px;
    color: var(--color-surface-300);
    font-size: 16px;
    line-height: 1.7;
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }
  .about-card:hover {
    border-color: var(--color-teal-700);
  }
  .about-card h2,
  .submit h2 {
    color: var(--color-surface-100);
    font-size: 22px;
    margin-top: 0;
    margin-bottom: 16px;
  }
  .about-card h3 {
    color: var(--color-surface-100);
    font-size: 16px;
    margin-top: 28px;
    margin-bottom: 16px;
  }
  .about-card p {
    margin-top: 0;
    margin-bottom: 16px;
  }
  .about-card p:last-child {
    margin-bottom: 0;
  }
  .about-card a {
    color: var(--color-teal-300);
  }
  .amber {
    color: var(--color-amber-400);
  }
  .cyan {
    color: var(--color-cyan-500);
  }
  .small {
    font-size: 13px;
    color: var(--color-teal-300);
    margin-top: 24px;
  }
  .archetype-list {
    display: grid;
    gap: 16px;
    margin-top: 16px;
  }
  .archetype {
    display: grid;
    grid-template-columns: 150px 1fr;
    gap: 16px;
    align-items: center;
    border-top: 1px solid var(--color-teal-700);
    padding-top: 14px;
  }
  .archetype b,
  .archetype span {
    display: block;
  }
  .archetype b {
    color: var(--color-surface-100);
    font: 13px var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .archetype span {
    color: var(--color-surface-300);
    font-size: 14px;
    line-height: 1.5;
    margin-top: 4px;
  }
  .submit {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    margin-top: 32px;
    padding: 32px 36px;
  }
  .submit h2 {
    margin-bottom: 0;
  }
  .button {
    display: inline-block;
    border: 1px solid;
    padding: 12px 20px;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease;
  }
  .button--amber {
    border-color: var(--color-amber-400);
    background: var(--color-amber-400);
    color: var(--color-ink);
  }
  .button--amber:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 14px rgba(251, 176, 59, 0.25);
  }
  @media (max-width: 800px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }
  @media (max-width: 650px) {
    .about-page {
      padding: 25px 16px 60px;
    }
    .submit {
      flex-direction: column;
      align-items: flex-start;
      padding: 24px;
    }
    .submit .button {
      width: 100%;
      text-align: center;
    }
    .archetype {
      grid-template-columns: 1fr;
      gap: 8px;
    }
  }
</style>
