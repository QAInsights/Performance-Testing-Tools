---
import ConsoleLayout from '../../layouts/ConsoleLayout.astro';
import Directory from '../../components/Directory.astro';
import { tools, type Category } from '../../data/tools';
import { breadcrumbs, toolItemList } from '../../lib/seo';
import { absoluteUrl } from '../../lib/urls';
import {
  categoryDescription,
  categoryIntro,
  categoryTitle,
} from '../../lib/pageMeta';

export function getStaticPaths() {
  return [...new Set(tools.map((tool) => tool.category))].map((category) => ({
    params: { category: category.toLowerCase().replaceAll(/[^a-z0-9]+/g, '-') },
    props: { category },
  }));
}
const { category } = Astro.props as { category: Category };
const categoryTools = tools.filter((tool) => tool.category === category);
---

<ConsoleLayout
  title={categoryTitle(category)}
  description={categoryDescription(category)}
  structuredData={[
    toolItemList(categoryTools),
    breadcrumbs([
      { name: 'Directory', path: '' },
      {
        name: category,
        path: `categories/${category.toLowerCase().replaceAll(/[^a-z0-9]+/g, '-')}`,
      },
    ]),
  ]}
  canonical={absoluteUrl(
    `categories/${category.toLowerCase().replaceAll(/[^a-z0-9]+/g, '-')}`,
  )}
>
  <Directory
    category={category}
    title={category}
    intro={categoryIntro(category)}
  />
</ConsoleLayout>
