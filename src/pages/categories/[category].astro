---
import ConsoleLayout from '../../layouts/ConsoleLayout.astro';
import Directory from '../../components/Directory.astro';
import { tools, type Category } from '../../data/tools';

export function getStaticPaths() {
  return [...new Set(tools.map((tool) => tool.category))].map((category) => ({ params: { category: category.toLowerCase().replaceAll(/[^a-z0-9]+/g, '-') }, props: { category } }));
}
const { category } = Astro.props as { category: Category };
---
<ConsoleLayout title={`${category} · Performance Testing Tools`}>
  <Directory category={category} title={category} intro={`A focused signal view of ${category.toLowerCase()} tools.`} />
</ConsoleLayout>
