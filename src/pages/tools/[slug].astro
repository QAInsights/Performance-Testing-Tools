---
import ConsoleLayout from '../../layouts/ConsoleLayout.astro';
import LoadProfile from '../../components/LoadProfile.astro';
import ToolBadges from '../../components/ToolBadges.astro';
import { tools } from '../../data/tools';
import { siteUrl } from '../../lib/urls';

export function getStaticPaths() { return tools.map((tool) => ({ params: { slug: tool.slug }, props: { tool } })); }
const { tool } = Astro.props;
const similar = tools.filter((item) => item.category === tool.category && item.slug !== tool.slug).slice(0, 4);
---
<ConsoleLayout title={`${tool.name} · Performance Testing Tools`} description={tool.description}>
  <main class="detail-page">
    <nav class="breadcrumbs mono"><a href={siteUrl()}>Directory</a><span>/</span><a href={siteUrl(`categories/${tool.category.toLowerCase().replaceAll(/[^a-z0-9]+/g, '-')}`)}>{tool.category}</a><span>/</span><strong>{tool.name}</strong></nav>
    <header class="detail-hero panel"><div><p class="eyebrow">TOOL SIGNAL / {tool.status.toUpperCase()}</p><h1>{tool.name}</h1><p class="detail-vendor">{tool.vendor}</p><div class="detail-badges"><ToolBadges tool={tool} /></div></div><div class="hero-profile"><LoadProfile tool={tool} large /></div></header>
    {tool.status !== 'Active' && <aside class="status-callout panel"><strong>{tool.status}</strong><span>{tool.successor ? `Successor: ${tool.successor}` : 'Current product status requires verification.'}</span></aside>}
    <div class="detail-grid"><article class="detail-copy"><p class="lead">{tool.longDescription}</p><h2>Signal notes</h2><dl class="metadata-grid"><div><dt>License</dt><dd>{tool.license}</dd></div><div><dt>Deployment</dt><dd>{tool.deployment}</dd></div><div><dt>Pricing</dt><dd>{tool.pricingModel}</dd></div><div><dt>First released</dt><dd>{tool.firstReleased ?? 'Not verified'}</dd></div><div><dt>Scripting</dt><dd>{tool.scriptingLanguages.join(', ')}</dd></div><div><dt>Protocols</dt><dd>{tool.protocols.join(', ')}</dd></div><div><dt>Operating systems</dt><dd>{tool.osSupport.join(', ')}</dd></div><div><dt>Tags</dt><dd>{tool.tags.join(' · ')}</dd></div></dl><div class="detail-actions"><a class="button button--amber" href={tool.url} target="_blank" rel="noreferrer">Official site ↗</a>{tool.repoUrl && <a class="button button--ghost" href={tool.repoUrl} target="_blank" rel="noreferrer">Source repo ↗</a>}</div></article><aside><p class="eyebrow">RELATED SIGNALS</p><div class="similar-list">{similar.map((item) => <a class="similar-item panel focus-ring" href={siteUrl(`tools/${item.slug}`)}><span>{item.name}</span><small>{item.vendor}</small></a>)}</div></aside></div>
  </main>
</ConsoleLayout>

<style>
  .detail-page { max-width:1180px; margin:0 auto; padding:38px 24px 80px; }.breadcrumbs { display:flex; gap:10px; color:var(--color-surface-300); font-size:11px; margin-bottom:26px; }.breadcrumbs a { color:var(--color-teal-300); }.detail-hero { display:grid; grid-template-columns:1fr 1fr; gap:30px; padding:32px; }.detail-hero h1 { font-size:clamp(38px,7vw,82px); letter-spacing:-.07em; margin:0; }.detail-vendor { color:var(--color-surface-300); font:14px var(--font-mono); }.detail-badges { margin-top:24px; }.hero-profile { align-self:center; }.status-callout { display:flex; gap:14px; align-items:center; margin-top:12px; padding:14px 18px; border-color:var(--color-amber-400); color:var(--color-amber-400); font:12px var(--font-mono); }.status-callout span { color:var(--color-surface-300); }.detail-grid { display:grid; grid-template-columns:minmax(0,1.5fr) minmax(220px,.7fr); gap:55px; margin-top:52px; }.lead { color:var(--color-surface-100); font-size:19px; line-height:1.65; }.detail-copy h2 { color:var(--color-teal-300); font:12px var(--font-mono); letter-spacing:.1em; margin-top:38px; }.metadata-grid { display:grid; grid-template-columns:repeat(2,1fr); border-top:1px solid var(--color-teal-700); }.metadata-grid div { padding:14px 0; border-bottom:1px solid color-mix(in srgb, var(--color-teal-300) 15%, transparent); }.metadata-grid dt { color:var(--color-surface-300); font:10px var(--font-mono); text-transform:uppercase; }.metadata-grid dd { margin:5px 14px 0 0; color:var(--color-surface-100); font-size:13px; }.detail-actions { display:flex; gap:10px; margin-top:28px; }.button--ghost { border-color:var(--color-teal-700); color:var(--color-teal-300); text-decoration:none; }.similar-list { display:grid; gap:8px; }.similar-item { display:block; padding:12px; color:var(--color-surface-100); text-decoration:none; }.similar-item small { display:block; color:var(--color-surface-300); font:10px var(--font-mono); margin-top:4px; }.similar-item:hover { border-color:var(--color-amber-400); }@media(max-width:700px){.detail-page{padding:24px 14px}.detail-hero{grid-template-columns:1fr;padding:22px}.hero-profile{overflow:hidden}.detail-grid{grid-template-columns:1fr;gap:32px}.metadata-grid{grid-template-columns:1fr}}
</style>
