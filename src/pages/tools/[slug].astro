---
import ConsoleLayout from '../../layouts/ConsoleLayout.astro';
import LoadProfile from '../../components/LoadProfile.astro';
import ToolBadges from '../../components/ToolBadges.astro';
import Footer from '../../components/Footer.astro';
import { tools } from '../../data/tools';
import { siteUrl } from '../../lib/urls';
import { breadcrumbs, toolFaq, toolSoftwareApplication } from '../../lib/seo';
import { absoluteUrl } from '../../lib/urls';
import { getEnrichment } from '../../lib/enrichmentData';

export function getStaticPaths() {
  return tools.map((tool) => ({
    params: { slug: tool.slug },
    props: { tool },
  }));
}
const { tool } = Astro.props;
const similar = tools
  .filter((item) => item.category === tool.category && item.slug !== tool.slug)
  .slice(0, 4);
const enrichment = getEnrichment(tool.slug);
const enrichmentDate = enrichment
  ? new Date(enrichment.fetchedAt).toISOString().slice(0, 10)
  : '';
const about = enrichment?.about || tool.longDescription;
const normalized = (value: string) =>
  value.trim().toLowerCase().replace(/\s+/g, ' ');
const maintainedBy =
  enrichment?.authorOrCompany &&
  normalized(enrichment.authorOrCompany) !== normalized(tool.vendor)
    ? enrichment.authorOrCompany
    : undefined;
const latestRelease = enrichment?.latestRelease;
const hasLatestRelease =
  latestRelease &&
  Boolean(latestRelease.version || latestRelease.date || latestRelease.notes);
const hasSpecs =
  tool.scriptingLanguages.length > 0 ||
  tool.protocols.length > 0 ||
  tool.osSupport.length > 0 ||
  tool.tags.length > 0;
const sourceHost = (url: string) => {
  try {
    return new URL(url).hostname.replace(/^www\./, '');
  } catch {
    return url;
  }
};
---

<ConsoleLayout
  title={`${tool.name} · Performance Testing Tools`}
  description={tool.description}
  ogImage={siteUrl(`og/${tool.slug}.png`)}
  canonical={absoluteUrl(`tools/${tool.slug}`)}
  structuredData={[
    toolSoftwareApplication(tool),
    toolFaq(tool),
    breadcrumbs([
      { name: 'Directory', path: '' },
      {
        name: tool.category,
        path: `categories/${tool.category.toLowerCase().replaceAll(/[^a-z0-9]+/g, '-')}`,
      },
      { name: tool.name, path: `tools/${tool.slug}` },
    ]),
  ]}
>
  <main class="detail-page">
    <nav class="breadcrumbs mono">
      <a href={siteUrl()}>Directory</a><span>/</span><a
        href={siteUrl(
          `categories/${tool.category.toLowerCase().replaceAll(/[^a-z0-9]+/g, '-')}`,
        )}>{tool.category}</a
      ><span>/</span><strong>{tool.name}</strong>
    </nav>
    <header class="detail-hero panel">
      <div class="hero-content">
        <p class="eyebrow">TOOL SIGNAL / {tool.status.toUpperCase()}</p><h1>
          {tool.name}
        </h1><p class="detail-vendor">{tool.vendor}</p><div
          class="detail-badges"
        >
          <ToolBadges tool={tool} />
        </div>{
          maintainedBy && (
            <p class="maintained-by mono">MAINTAINED BY · {maintainedBy}</p>
          )
        }<div class="detail-actions">
          <a
            class="button button--amber"
            href={tool.url}
            target="_blank"
            rel="noreferrer">Official site ↗</a
          >{
            tool.repoUrl && (
              <a
                class="button button--ghost"
                href={tool.repoUrl}
                target="_blank"
                rel="noreferrer"
              >
                Source repo ↗
              </a>
            )
          }
        </div>
      </div><div class="hero-profile"><LoadProfile tool={tool} large /></div>
    </header>
    <dl class="summary-strip panel" aria-label="At a glance">
      <div><dt>License</dt><dd>{tool.license}</dd></div>
      <div><dt>Deployment</dt><dd>{tool.deployment}</dd></div>
      <div><dt>Pricing model</dt><dd>{tool.pricingModel}</dd></div>
      <div>
        <dt>First released</dt><dd>{tool.firstReleased ?? 'Not verified'}</dd>
      </div>
      {
        latestRelease?.version && (
          <div>
            <>
              <dt>Latest release</dt>
              <dd>{latestRelease.version}</dd>
            </>
          </div>
        )
      }
    </dl>
    {
      tool.status !== 'Active' && (
        <aside class="status-callout panel">
          <>
            <strong>{tool.status}</strong>
            <span>
              {tool.successor
                ? `Successor: ${tool.successor}`
                : 'Current product status requires verification.'}
            </span>
          </>
        </aside>
      )
    }
    <div class="detail-grid">
      <article class="detail-copy">
        <section class="detail-section">
          <h2>About</h2>
          <p class="lead">{about}</p>
        </section>
        {
          enrichment?.features && enrichment.features.length > 0 && (
            <section class="detail-section">
              <h2>Features</h2>
              <ul class="feature-list">
                {enrichment.features.map((feature) => (
                  <li>{feature}</li>
                ))}
              </ul>
            </section>
          )
        }{
          enrichment?.aiFeatures && enrichment.aiFeatures.length > 0 && (
            <section class="detail-section">
              <h2>AI features</h2>
              <ul class="feature-list">
                {enrichment.aiFeatures.map((feature) => (
                  <li>{feature}</li>
                ))}
              </ul>
            </section>
          )
        }{
          hasLatestRelease && (
            <section class="detail-section">
              <h2>Latest release</h2>
              <p class="release-line">
                {[latestRelease.version, latestRelease.date]
                  .filter(Boolean)
                  .join(' · ')}
              </p>
              {latestRelease.notes && <p>{latestRelease.notes}</p>}
            </section>
          )
        }{
          enrichment?.pricing && (
            <section class="detail-section">
              <h2>Pricing</h2>
              <p>{enrichment.pricing}</p>
            </section>
          )
        }
        {
          hasSpecs && (
            <section class="detail-section">
              <h2>Specs</h2>
              <dl class="metadata-grid">
                {tool.scriptingLanguages.length > 0 && (
                  <div>
                    <dt>Scripting</dt>
                    <dd>
                      <span class="spec-chips">
                        {tool.scriptingLanguages.map((item) => (
                          <span class="spec-chip">{item}</span>
                        ))}
                      </span>
                    </dd>
                  </div>
                )}
                {tool.protocols.length > 0 && (
                  <div>
                    <dt>Protocols</dt>
                    <dd>
                      <span class="spec-chips">
                        {tool.protocols.map((item) => (
                          <span class="spec-chip">{item}</span>
                        ))}
                      </span>
                    </dd>
                  </div>
                )}
                {tool.osSupport.length > 0 && (
                  <div>
                    <dt>Operating systems</dt>
                    <dd>
                      <span class="spec-chips">
                        {tool.osSupport.map((item) => (
                          <span class="spec-chip">{item}</span>
                        ))}
                      </span>
                    </dd>
                  </div>
                )}
                {tool.tags.length > 0 && (
                  <div>
                    <dt>Tags</dt>
                    <dd>
                      <span class="spec-chips">
                        {tool.tags.map((item) => (
                          <span class="spec-chip">{item}</span>
                        ))}
                      </span>
                    </dd>
                  </div>
                )}
              </dl>
            </section>
          )
        }
        {
          enrichment?.sources && enrichment.sources.length > 0 && (
            <section class="detail-section sources-section">
              <details class="source-details">
                <summary>
                  <>
                    <h2>Sources</h2>
                    <span class="disclosure-hint mono">SHOW SOURCES</span>
                  </>
                </summary>
                <ul class="source-list">
                  {enrichment.sources.map((source) => (
                    <li>
                      <a href={source.url} target="_blank" rel="noreferrer">
                        <strong>{sourceHost(source.url)}</strong>
                        <span>{source.title}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </details>
              <p class="enrichment-stamp mono">
                GROUNDED VIA EXA · {enrichmentDate}
              </p>
            </section>
          )
        }
      </article><aside>
        <div class="related-sidebar">
          <p class="eyebrow">RELATED SIGNALS</p><div class="similar-list">
            {
              similar.map((item) => (
                <a
                  class="similar-item panel focus-ring"
                  href={siteUrl(`tools/${item.slug}`)}
                >
                  <>
                    <span>{item.name}</span>
                    <small>{item.vendor}</small>
                  </>
                </a>
              ))
            }
          </div>
        </div>
      </aside>
    </div>
    <details class="faq-block panel">
      <summary
        ><h2>Frequently asked</h2><span class="disclosure-hint mono"
          >SHOW FAQ</span
        ></summary
      >
      <div class="faq-list">
        <div>
          <strong>Is it open source?</strong><p>
            {
              tool.license === 'Open Source'
                ? `Yes. ${tool.name} is listed as open source.`
                : tool.license === 'Commercial'
                  ? `No. ${tool.name} is listed as commercial.`
                  : `${tool.name} is listed as freemium.`
            }
          </p>
        </div>{
          tool.protocols.length > 0 && (
            <div>
              <strong>What protocols does it support?</strong>
              <p>
                {tool.name} supports {tool.protocols.join(', ')}.
              </p>
            </div>
          )
        }<div>
          <strong>Is it cloud or self-hosted?</strong><p>
            {tool.name} is listed as {tool.deployment.toLowerCase()}.
          </p>
        </div>{
          tool.status !== 'Unknown' && (
            <div>
              <strong>Is it still maintained?</strong>
              <p>
                {tool.status === 'Active'
                  ? `${tool.name} is listed as active.`
                  : `${tool.name} is listed as discontinued${tool.successor ? `; its successor is ${tool.successor}.` : '.'}`}
              </p>
            </div>
          )
        }
      </div>
    </details>
    <Footer />
  </main>
</ConsoleLayout>

<style>
  .detail-page {
    max-width: 1180px;
    margin: 0 auto;
    padding: 38px 24px 80px;
  }
  .breadcrumbs {
    display: flex;
    gap: 10px;
    color: var(--color-surface-300);
    font-size: 11px;
    margin-bottom: 26px;
  }
  .breadcrumbs a {
    color: var(--color-teal-300);
  }
  .detail-hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 30px;
    padding: 32px;
  }
  .detail-hero h1 {
    font-size: clamp(38px, 7vw, 82px);
    letter-spacing: -0.07em;
    margin: 0;
  }
  .hero-content {
    min-width: 0;
  }
  .detail-vendor {
    color: var(--color-surface-300);
    font: 14px var(--font-mono);
  }
  .detail-badges {
    margin-top: 24px;
  }
  .maintained-by {
    color: var(--color-surface-300);
    font-size: 10px;
    letter-spacing: 0.08em;
    margin: 18px 0 0;
  }
  .hero-profile {
    align-self: center;
  }
  .summary-strip {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 18px;
    margin-top: 12px;
    padding: 16px 20px;
  }
  .summary-strip div {
    min-width: 0;
  }
  .summary-strip dt,
  .metadata-grid dt {
    color: var(--color-surface-300);
    font: 10px var(--font-mono);
    text-transform: uppercase;
  }
  .summary-strip dd {
    color: var(--color-surface-100);
    font-size: 13px;
    line-height: 1.35;
    margin: 5px 0 0;
    overflow-wrap: anywhere;
  }
  .status-callout {
    display: flex;
    gap: 14px;
    align-items: center;
    margin-top: 12px;
    padding: 14px 18px;
    border-color: var(--color-amber-400);
    color: var(--color-amber-400);
    font: 12px var(--font-mono);
  }
  .status-callout span {
    color: var(--color-surface-300);
  }
  .detail-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(220px, 0.7fr);
    gap: 55px;
    margin-top: 52px;
  }
  .detail-copy {
    min-width: 0;
  }
  .detail-section {
    border-top: 1px solid var(--color-teal-700);
    padding-top: 22px;
  }
  .detail-section + .detail-section {
    margin-top: 34px;
  }
  .lead {
    color: var(--color-surface-100);
    font-size: 19px;
    line-height: 1.65;
  }
  .detail-section > p,
  .detail-section li {
    color: var(--color-surface-300);
    font-size: 13px;
    line-height: 1.55;
  }
  .feature-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px 24px;
    margin: 0;
    padding-left: 18px;
  }
  .feature-list li {
    overflow-wrap: anywhere;
  }
  .release-line {
    color: var(--color-surface-100) !important;
    font-family: var(--font-mono);
  }
  .source-list {
    list-style: none;
    margin: 18px 0 0;
    padding: 0;
  }
  .source-list li + li {
    margin-top: 9px;
  }
  .source-list a {
    display: block;
    color: var(--color-teal-300);
    text-decoration: none;
  }
  .source-list strong,
  .source-list span {
    display: block;
    overflow-wrap: anywhere;
  }
  .source-list strong {
    font: 11px var(--font-mono);
  }
  .source-list span {
    color: var(--color-surface-300);
    font-size: 12px;
    line-height: 1.4;
    margin-top: 2px;
  }
  .enrichment-stamp {
    color: var(--color-surface-400) !important;
    font-size: 10px !important;
    letter-spacing: 0.08em;
    margin: 18px 0 0;
  }
  .detail-copy h2,
  .faq-block h2 {
    color: var(--color-teal-300);
    font: 12px var(--font-mono);
    letter-spacing: 0.1em;
    margin: 0 0 14px;
  }
  .metadata-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    margin: 0;
  }
  .metadata-grid div {
    min-width: 0;
    padding: 11px 0;
    border-bottom: 1px solid
      color-mix(in srgb, var(--color-teal-300) 15%, transparent);
  }
  .metadata-grid dd {
    margin: 6px 14px 0 0;
    color: var(--color-surface-100);
    font-size: 13px;
  }
  .spec-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
  }
  .spec-chip {
    border: 1px solid var(--color-teal-700);
    border-radius: 2px;
    color: var(--color-teal-300);
    display: inline-block;
    font: 10px var(--font-mono);
    line-height: 1.2;
    max-width: 100%;
    overflow-wrap: anywhere;
    padding: 4px 6px;
  }
  .detail-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 28px;
  }
  .button--ghost {
    border-color: var(--color-teal-700);
    color: var(--color-teal-300);
    text-decoration: none;
  }
  .related-sidebar {
    position: sticky;
    top: 24px;
  }
  .related-sidebar .eyebrow {
    margin-bottom: 14px;
  }
  .similar-list {
    display: grid;
    gap: 10px;
    margin-top: 14px;
  }
  .similar-item {
    display: block;
    padding: 12px;
    color: var(--color-surface-100);
    text-decoration: none;
  }
  .similar-item small {
    display: block;
    color: var(--color-surface-300);
    font: 10px var(--font-mono);
    margin-top: 4px;
  }
  .similar-item:hover {
    border-color: var(--color-amber-400);
  }
  .faq-block {
    margin-top: 28px;
    padding: 20px;
  }
  .faq-block summary,
  .source-details summary {
    align-items: center;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    list-style: none;
  }
  .faq-block summary::-webkit-details-marker,
  .source-details summary::-webkit-details-marker {
    display: none;
  }
  .faq-block summary h2,
  .source-details summary h2 {
    margin: 0;
  }
  .disclosure-hint {
    color: var(--color-surface-300);
    font-size: 10px;
    letter-spacing: 0.08em;
  }
  .source-details {
    border-top: 1px solid var(--color-teal-700);
    padding-top: 22px;
  }
  .faq-list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 15px;
    margin-top: 22px;
  }
  .faq-list div {
    border-top: 1px solid var(--color-teal-700);
    padding-top: 10px;
  }
  .faq-list strong {
    font: 11px var(--font-mono);
    color: var(--color-surface-100);
  }
  .faq-list p {
    color: var(--color-surface-300);
    font-size: 13px;
    line-height: 1.5;
  }
  @media (max-width: 700px) {
    .detail-page {
      padding: 24px 14px;
    }
    .detail-hero {
      grid-template-columns: 1fr;
      padding: 22px;
    }
    .summary-strip {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px;
    }
    .hero-profile {
      overflow: hidden;
    }
    .detail-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .metadata-grid,
    .faq-list {
      grid-template-columns: 1fr;
    }
    .feature-list {
      grid-template-columns: 1fr;
    }
    .related-sidebar {
      position: static;
    }
  }
</style>
