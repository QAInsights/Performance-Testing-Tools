---
import ConsoleLayout from '../../layouts/ConsoleLayout.astro';
import LoadProfile from '../../components/LoadProfile.astro';
import ToolBadges from '../../components/ToolBadges.astro';
import VerifiedBadge from '../../components/VerifiedBadge.astro';
import Footer from '../../components/Footer.astro';
import ToolRelatedLinks from '../../components/ToolRelatedLinks.astro';
import { datasetLastVerified, tools } from '../../data/tools';
import { getReview } from '../../data/reviews';
import { absoluteUrl, siteUrl } from '../../lib/urls';
import { breadcrumbs, toolFaq, toolSoftwareApplication } from '../../lib/seo';
import { getEnrichment } from '../../lib/enrichmentData';
import { getGithubHealth } from '../../lib/githubHealth';
import { buildToolFaq } from '../../lib/toolFaq';
import { toolDescription, toolTitle } from '../../lib/pageMeta';
import { curatorPerson } from '../../lib/methodology';
import {
  alternativesForHub,
  alternativesHubForTool,
  comparisonsForTool,
} from '../../lib/comparisonContent';
import { hubPeers } from '../../lib/derivedComparisons';
import {
  architectureLine,
  bestFor,
  notBestFor,
  toolAnswerBox,
} from '../../lib/toolEntity';
import '../../styles/editorial.css';
import '../../styles/review.css';

export function getStaticPaths() {
  return tools.map((tool) => ({
    params: { slug: tool.slug },
    props: { tool },
  }));
}
const { tool } = Astro.props;
const review = getReview(tool.slug);
const enrichment = getEnrichment(tool.slug, tool);
const faqItems = buildToolFaq(tool, tools);
const answerBox = toolAnswerBox(tool, enrichment);
const bestForItems = bestFor(tool);
const notBestForItems = notBestFor(tool);
const architecture = architectureLine(tool);
const comparisonPages = comparisonsForTool(tool.slug, tools);
const alternativesHub = alternativesHubForTool(tool.slug, tools);
const alternativesCount = alternativesHub
  ? alternativesHub.tier === 'B'
    ? hubPeers(tool, tools).length
    : alternativesForHub(alternativesHub, tools).length
  : 0;
const enrichmentDate = enrichment
  ? new Date(enrichment.fetchedAt).toISOString().slice(0, 10)
  : datasetLastVerified;
const about = enrichment?.about || tool.longDescription;
const normalized = (value: string) =>
  value.trim().toLowerCase().replace(/\s+/g, ' ');
const wordCount = (value: string) => value.trim().split(/\s+/).length;
const answerText = wordCount(about) <= 120 ? about : answerBox;
const normalizedAnswer = normalized(answerText)
  .replace(/\s+status:.*$/i, '')
  .replace(/\.+$/, '');
const normalizedAbout = normalized(about);
const answerMatchesAbout =
  normalizedAbout === normalizedAnswer ||
  normalizedAbout.startsWith(`${normalizedAnswer} `);
const hasAbout = !answerMatchesAbout;
const maintainedBy =
  enrichment?.authorOrCompany &&
  normalized(enrichment.authorOrCompany) !== normalized(tool.vendor)
    ? enrichment.authorOrCompany
    : undefined;
const latestRelease = enrichment?.latestRelease;
const hasLatestRelease =
  latestRelease &&
  Boolean(latestRelease.version || latestRelease.date || latestRelease.notes);
const hasSpecs =
  tool.scriptingLanguages.length > 0 ||
  tool.protocols.length > 0 ||
  tool.osSupport.length > 0 ||
  tool.tags.length > 0;
const repoHealth = getGithubHealth(tool.slug);
const hasRepoHealth = Boolean(repoHealth);
const hasFactSheet =
  hasSpecs || hasRepoHealth || hasLatestRelease || Boolean(enrichment?.pricing);
const sourceHost = (url: string) => {
  try {
    return new URL(url).hostname.replace(/^www\./, '');
  } catch {
    return url;
  }
};
const reviewSummary =
  review?.verdict.match(/^.*?[.!?](?:\s|$)/)?.[0].trim() || review?.verdict;
---

<ConsoleLayout
  title={toolTitle(tool)}
  description={toolDescription(tool)}
  ogImage={siteUrl(`og/${tool.slug}.png`)}
  ogType="article"
  markdownHref={siteUrl(`tools/${tool.slug}.md`)}
  canonical={absoluteUrl(`tools/${tool.slug}`)}
  structuredData={[
    toolSoftwareApplication(tool, enrichment),
    toolFaq(tool, tools, faqItems, enrichment),
    breadcrumbs([
      { name: 'Directory', path: '' },
      {
        name: tool.category,
        path: `categories/${tool.category.toLowerCase().replaceAll(/[^a-z0-9]+/g, '-')}`,
      },
      { name: tool.name, path: `tools/${tool.slug}` },
    ]),
  ]}
>
  <main class="detail-page">
    <nav class="breadcrumbs mono">
      <a href={siteUrl()}>Directory</a><span>/</span><a
        href={siteUrl(
          `categories/${tool.category.toLowerCase().replaceAll(/[^a-z0-9]+/g, '-')}`,
        )}>{tool.category}</a
      ><span>/</span><strong>{tool.name}</strong>
    </nav>
    <header class="detail-hero panel">
      <div class="hero-content">
        <p class="eyebrow">
          {
            review
              ? `TOOL REVIEW / ${tool.status.toUpperCase()}`
              : `TOOL SIGNAL / ${tool.status.toUpperCase()}`
          }
        </p><h1>
          {tool.name}
          <VerifiedBadge tool={tool} size="lg" />
        </h1><p class="detail-vendor">{tool.vendor}</p><div
          class="detail-badges"
        >
          <ToolBadges tool={tool} />
        </div>{
          (
            <p class="review-stamp mono">
              {review
                ? `REVIEWED · ${review.reviewedAt} · ${review.handsOn ? 'HANDS-ON' : 'DESK REVIEW'}`
                : 'NOT YET REVIEWED · CATALOG DATA'}
            </p>
          )
        }{
          maintainedBy && (
            <p class="maintained-by mono">MAINTAINED BY · {maintainedBy}</p>
          )
        }<div class="detail-actions">
          <a
            class="button button--amber"
            href={tool.url}
            target="_blank"
            rel="noreferrer">Official site ↗</a
          >{
            tool.repoUrl && (
              <a
                class="button button--ghost"
                href={tool.repoUrl}
                target="_blank"
                rel="noreferrer"
              >
                Source repo ↗
              </a>
            )
          }
        </div>
      </div><div class="hero-profile"><LoadProfile tool={tool} large /></div>
    </header>
    <dl class="summary-strip panel" aria-label="At a glance">
      <div><dt>Pricing model</dt><dd>{tool.pricingModel}</dd></div>
      <div>
        <dt>First released</dt><dd>{tool.firstReleased ?? 'Not verified'}</dd>
      </div>
      {
        latestRelease?.version && (
          <div>
            <>
              <dt>Latest release</dt>
              <dd>{latestRelease.version}</dd>
            </>
          </div>
        )
      }
      <div>
        <dt>Last verified</dt>
        <dd>
          <time datetime={enrichmentDate}>{enrichmentDate}</time>
        </dd>
      </div>
    </dl>
    {
      review && (
        <a class="review-cta panel" href={siteUrl(`reviews/${tool.slug}`)}>
          <span class="review-cta-label mono">
            READ THE {tool.name} REVIEW →
          </span>
          <strong>{reviewSummary}</strong>
          <span class="review-cta-meta mono">
            {review.reviewedAt} · {review.handsOn ? 'HANDS-ON' : 'DESK REVIEW'}
          </span>
        </a>
      )
    }
    <nav class="jump-list mono" aria-label="On this page">
      <span>JUMP TO</span>
      <a href="#verdict">Answer</a>
      <a href="#pros-cons">Best for</a>
      {hasFactSheet && <a href="#specs">Specs</a>}
      {
        (comparisonPages.length > 0 || alternativesHub) && (
          <a href="#alternatives">Alternatives</a>
        )
      }
      <a href="#faq">FAQ</a>
    </nav>
    {
      tool.status !== 'Active' && (
        <aside class="status-callout panel">
          <>
            <strong>{tool.status}</strong>
            <span>
              {tool.successor
                ? `Successor: ${tool.successor}`
                : 'Current product status requires verification.'}
            </span>
          </>
        </aside>
      )
    }
    <div class="answer-box panel" id="verdict">
      <span class="answer-box-label mono">Answer</span>
      <p>{answerText}</p>
    </div>
    <div class="detail-grid">
      <article class="detail-copy">
        {
          (hasAbout ||
            Boolean(enrichment?.features?.length) ||
            Boolean(enrichment?.aiFeatures?.length)) && (
            <section class="detail-section">
              <h2>What it is</h2>
              {hasAbout && <p class="lead">{about}</p>}
              {enrichment?.features && enrichment.features.length > 0 && (
                <div class="what-it-is-block">
                  <h3>Features</h3>
                  <ul class="feature-list">
                    {enrichment.features.map((feature) => (
                      <li>{feature}</li>
                    ))}
                  </ul>
                </div>
              )}
              {enrichment?.aiFeatures && enrichment.aiFeatures.length > 0 && (
                <div class="what-it-is-block">
                  <span class="subsection-label mono">AI</span>
                  <ul class="feature-list">
                    {enrichment.aiFeatures.map((feature) => (
                      <li>{feature}</li>
                    ))}
                  </ul>
                </div>
              )}
            </section>
          )
        }
        <section class="detail-section" id="pros-cons">
          <h2>Best for</h2>
          <ul class="feature-list">
            {bestForItems.map((item) => <li>{item}</li>)}
          </ul>
        </section>
        <section class="detail-section">
          <h2>Not the best fit when</h2>
          <ul class="feature-list">
            {notBestForItems.map((item) => <li>{item}</li>)}
          </ul>
        </section>
        <section class="detail-section">
          <h2>Architecture and concurrency</h2>
          <p>{architecture}</p>
        </section>
        {
          hasFactSheet && (
            <section class="detail-section fact-sheet" id="specs">
              <h2>Fact sheet</h2>
              {(hasSpecs || hasRepoHealth) && (
                <>
                  <h3>Specs</h3>
                  <dl class="metadata-grid">
                    {tool.scriptingLanguages.length > 0 && (
                      <div>
                        <dt>Scripting</dt>
                        <dd>
                          <span class="spec-chips">
                            {tool.scriptingLanguages.map((item) => (
                              <span class="spec-chip">{item}</span>
                            ))}
                          </span>
                        </dd>
                      </div>
                    )}
                    {tool.protocols.length > 0 && (
                      <div>
                        <dt>Protocols</dt>
                        <dd>
                          <span class="spec-chips">
                            {tool.protocols.map((item) => (
                              <span class="spec-chip">{item}</span>
                            ))}
                          </span>
                        </dd>
                      </div>
                    )}
                    {tool.osSupport.length > 0 && (
                      <div>
                        <dt>Operating systems</dt>
                        <dd>
                          <span class="spec-chips">
                            {tool.osSupport.map((item) => (
                              <span class="spec-chip">{item}</span>
                            ))}
                          </span>
                        </dd>
                      </div>
                    )}
                    {tool.tags.length > 0 && (
                      <div>
                        <dt>Tags</dt>
                        <dd>
                          <span class="spec-chips">
                            {tool.tags.map((item) => (
                              <span class="spec-chip">{item}</span>
                            ))}
                          </span>
                        </dd>
                      </div>
                    )}
                    {repoHealth && (
                      <div>
                        <dt>Repo health</dt>
                        <dd class="repo-health-value">
                          <span>
                            ★ {repoHealth.stars} · last push{' '}
                            {repoHealth.lastPushedAt.slice(0, 10)}
                          </span>
                          {repoHealth.archived && (
                            <span class="repo-health-archived">
                              ARCHIVED REPO
                            </span>
                          )}
                        </dd>
                      </div>
                    )}
                  </dl>
                </>
              )}
              {hasLatestRelease && (
                <div class="fact-sheet-block">
                  <h3>Latest release</h3>
                  <p class="release-line">
                    {[latestRelease.version, latestRelease.date]
                      .filter(Boolean)
                      .join(' · ')}
                  </p>
                  {latestRelease.notes && <p>{latestRelease.notes}</p>}
                </div>
              )}
              {enrichment?.pricing && (
                <div class="fact-sheet-block">
                  <h3>Pricing</h3>
                  <p>{enrichment.pricing}</p>
                </div>
              )}
            </section>
          )
        }
        {
          enrichment?.sources && enrichment.sources.length > 0 && (
            <section class="detail-section sources-section">
              <details class="source-details">
                <summary>
                  <>
                    <h2>Sources</h2>
                    <span class="disclosure-hint mono">SHOW SOURCES</span>
                  </>
                </summary>
                <ul class="source-list">
                  {enrichment.sources.map((source) => (
                    <li>
                      <a
                        href={source.url}
                        target="_blank"
                        rel="nofollow noreferrer"
                      >
                        <strong>{sourceHost(source.url)}</strong>
                        <span>{source.title}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </details>
              <p class="enrichment-stamp mono">
                LAST VERIFIED · {enrichmentDate}
                {enrichment?.fetchedAt ? ' · GROUNDED VIA EXA' : ''}
                {' · '}
                <a href={siteUrl('about#methodology')}>
                  CURATED BY {curatorPerson.name.toUpperCase()}
                </a>
              </p>
            </section>
          )
        }
        {
          !enrichment?.sources?.length && (
            <p class="enrichment-stamp mono catalog-stamp">
              CATALOG LAST VERIFIED · {datasetLastVerified}
              {' · '}
              <a href={siteUrl('about#methodology')}>
                CURATED BY {curatorPerson.name.toUpperCase()}
              </a>
            </p>
          )
        }
      </article><aside id="alternatives">
        <ToolRelatedLinks
          tool={tool}
          catalog={tools}
          alternativesHref={alternativesHub
            ? siteUrl(`alternatives/${tool.slug}`)
            : undefined}
          alternativesLabel={alternativesHub?.headline}
          alternativesCount={alternativesHub ? alternativesCount : undefined}
        />
      </aside>
    </div>
    <section class="faq-block panel" id="faq" aria-labelledby="faq-heading">
      <div class="faq-head">
        <h2 id="faq-heading">Frequently asked</h2>
        <span class="disclosure-hint mono">ANSWER-SHAPED</span>
      </div>
      <div class="faq-list">
        {
          faqItems.map((item, index) => (
            <details class="faq-item" open={index < 2}>
              <summary>
                <strong>{item.question}</strong>
              </summary>
              <p>{item.answer}</p>
            </details>
          ))
        }
      </div>
    </section>
    <Footer markdownHref={siteUrl(`tools/${tool.slug}.md`)} />
  </main>
</ConsoleLayout>

<style>
  .detail-page {
    max-width: 1180px;
    margin: 0 auto;
    padding: 38px 24px 80px;
  }
  .breadcrumbs {
    display: flex;
    gap: 10px;
    color: var(--color-surface-300);
    font-size: 13px;
    margin-bottom: 26px;
  }
  .breadcrumbs a {
    color: var(--color-teal-300);
  }
  .detail-hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 30px;
    padding: 32px;
  }
  .detail-hero h1 {
    font-size: clamp(38px, 7vw, 82px);
    letter-spacing: -0.07em;
    margin: 0;
    background: linear-gradient(
      120deg,
      var(--color-surface-100) 0%,
      var(--color-teal-300) 30%,
      var(--color-amber-400) 65%,
      var(--color-cyan-500) 85%,
      var(--color-surface-100) 100%
    );
    background-size: 200% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    color: transparent;
    animation: headingGradient 7s linear infinite;
  }
  @keyframes headingGradient {
    0% {
      background-position: 0% center;
    }
    100% {
      background-position: 200% center;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .detail-hero h1 {
      animation: none;
    }
  }
  .hero-content {
    min-width: 0;
  }
  .detail-vendor {
    color: var(--color-surface-300);
    font: 15px var(--font-mono);
  }
  .detail-badges {
    margin-top: 24px;
  }
  .maintained-by {
    color: var(--color-surface-300);
    font-size: 12px;
    letter-spacing: 0.08em;
    margin: 18px 0 0;
  }
  .hero-profile {
    align-self: center;
  }
  .summary-strip {
    display: grid;
    grid-auto-flow: row;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 18px;
    margin-top: 12px;
    padding: 16px 20px;
  }
  .summary-strip div {
    min-width: 0;
  }
  .summary-strip dt,
  .metadata-grid dt {
    color: var(--color-surface-300);
    font: 12px var(--font-mono);
    text-transform: uppercase;
  }
  .summary-strip dd {
    color: var(--color-surface-100);
    font-size: 15px;
    line-height: 1.35;
    margin: 5px 0 0;
    overflow-wrap: anywhere;
  }
  .review-cta {
    border-color: var(--color-amber-400);
    color: inherit;
    display: grid;
    gap: 8px;
    margin-top: 14px;
    padding: 16px 18px;
    text-decoration: none;
  }
  .review-cta:hover {
    border-color: var(--color-teal-300);
  }
  .review-cta-label,
  .review-cta-meta {
    color: var(--color-amber-400);
    font-size: 11px;
    letter-spacing: 0.08em;
  }
  .review-cta strong {
    color: var(--color-surface-100);
    font-size: 16px;
    font-weight: 500;
    line-height: 1.45;
  }
  .jump-list {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 14px;
    margin: 16px 0 0;
    color: var(--color-surface-300);
    font-size: 12px;
    letter-spacing: 0.06em;
  }
  .jump-list span {
    color: var(--color-surface-400);
  }
  .jump-list a {
    color: var(--color-teal-300);
  }
  .answer-box {
    margin-top: 14px;
    padding: 16px 18px;
    border-left: 3px solid var(--color-amber-400);
  }
  .answer-box-label {
    display: block;
    color: var(--color-amber-400);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 8px;
  }
  .answer-box p {
    margin: 0;
    color: var(--color-surface-100);
    font-size: 16px;
    line-height: 1.55;
  }
  .detail-copy a {
    color: var(--color-teal-300);
  }
  .status-callout {
    display: flex;
    gap: 14px;
    align-items: center;
    margin-top: 12px;
    padding: 14px 18px;
    border-color: var(--color-amber-400);
    color: var(--color-amber-400);
    font: 14px var(--font-mono);
  }
  .status-callout span {
    color: var(--color-surface-300);
  }
  .detail-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(220px, 0.7fr);
    gap: 55px;
    margin-top: 52px;
  }
  .detail-copy {
    min-width: 0;
  }
  .detail-section {
    border-top: 1px solid var(--color-teal-700);
    padding-top: 22px;
  }
  .detail-section + .detail-section {
    margin-top: 34px;
  }
  .lead {
    color: var(--color-surface-100);
    font-size: 19px;
    line-height: 1.65;
  }
  .detail-section > p,
  .detail-section li {
    color: var(--color-surface-300);
    font-size: 15px;
    line-height: 1.6;
  }
  .feature-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px 24px;
    margin: 0;
    padding-left: 18px;
  }
  .comparison-list {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .feature-list li {
    overflow-wrap: anywhere;
  }
  .what-it-is-block,
  .fact-sheet-block {
    margin-top: 24px;
  }
  .what-it-is-block h3,
  .pros-cons-grid h3,
  .fact-sheet h3 {
    color: var(--color-surface-100);
    font: 13px var(--font-mono);
    letter-spacing: 0.06em;
    margin: 0 0 12px;
  }
  .subsection-label {
    margin-bottom: 12px;
  }
  .fact-sheet-block + .fact-sheet-block {
    border-top: 1px solid
      color-mix(in srgb, var(--color-teal-300) 15%, transparent);
    padding-top: 18px;
  }
  .release-line {
    color: var(--color-surface-100) !important;
    font-family: var(--font-mono);
  }
  .source-list {
    list-style: none;
    margin: 18px 0 0;
    padding: 0;
  }
  .source-list li + li {
    margin-top: 9px;
  }
  .source-list a {
    display: block;
    color: var(--color-teal-300);
    text-decoration: none;
  }
  .source-list strong,
  .source-list span {
    display: block;
    overflow-wrap: anywhere;
  }
  .source-list strong {
    font: 13px var(--font-mono);
  }
  .source-list span {
    color: var(--color-surface-300);
    font-size: 14px;
    line-height: 1.4;
    margin-top: 2px;
  }
  .enrichment-stamp {
    color: var(--color-surface-400) !important;
    font-size: 12px !important;
    letter-spacing: 0.08em;
    margin: 18px 0 0;
  }
  .catalog-stamp {
    margin-top: 28px;
    border-top: 1px solid var(--color-teal-700);
    padding-top: 16px;
  }
  .detail-copy h2,
  .faq-block h2 {
    color: var(--color-teal-300);
    font: 13px var(--font-mono);
    letter-spacing: 0.1em;
    margin: 0 0 14px;
  }
  .metadata-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    margin: 0;
  }
  .metadata-grid div {
    min-width: 0;
    padding: 11px 0;
    border-bottom: 1px solid
      color-mix(in srgb, var(--color-teal-300) 15%, transparent);
  }
  .metadata-grid dd {
    margin: 6px 14px 0 0;
    color: var(--color-surface-100);
    font-size: 15px;
  }
  .spec-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
  }
  .spec-chip {
    border: 1px solid var(--color-teal-700);
    border-radius: 2px;
    color: var(--color-teal-300);
    display: inline-block;
    font: 12px var(--font-mono);
    line-height: 1.2;
    max-width: 100%;
    overflow-wrap: anywhere;
    padding: 4px 6px;
  }
  .repo-health-value {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .repo-health-archived {
    border: 1px solid var(--color-amber-400);
    color: var(--color-amber-400);
    font: 11px var(--font-mono);
    letter-spacing: 0.06em;
    padding: 4px 6px;
  }
  .detail-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 28px;
  }
  .button--ghost {
    border-color: var(--color-teal-700);
    color: var(--color-teal-300);
    text-decoration: none;
  }
  .faq-block {
    margin-top: 28px;
    padding: 20px;
