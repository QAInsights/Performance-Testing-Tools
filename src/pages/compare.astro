---
import ConsoleLayout from '../layouts/ConsoleLayout.astro';
import { tools } from '../data/tools';
import { siteUrl } from '../lib/urls';
const serializedTools = tools.map(({ slug, name, vendor, category, license, deployment, scriptingLanguages, protocols, status, firstReleased, pricingModel }) => ({ slug, name, vendor, category, license, deployment, scriptingLanguages, protocols, status, firstReleased, pricingModel }));
---
<ConsoleLayout title="Test Rig · Performance Testing Tools">
  <main class="compare-page">
    <nav class="breadcrumbs mono"><a href={siteUrl()}>← Directory</a><span>/</span><strong>Test Rig</strong></nav>
    <header><p class="eyebrow">COMPARISON MATRIX</p><h1>Test Rig</h1><p class="intro">Put up to three load profiles side by side. Share this URL with your team.</p></header>
    <div data-compare-matrix class="matrix panel"></div>
    <p data-compare-empty class="empty panel" hidden>Select tools from the directory to populate the rig.</p>
  </main>
</ConsoleLayout>
<script define:vars={{ serializedTools }}>
  const matrix = document.querySelector('[data-compare-matrix]');
  const empty = document.querySelector('[data-compare-empty]');
  const selected = new URLSearchParams(location.search).get('tools')?.split(',').filter(Boolean) || [];
  const data = serializedTools.filter((tool) => selected.includes(tool.slug));
  if (!data.length) { if (empty) empty.hidden = false; }
  else if (matrix) {
    const fields = [['Vendor', 'vendor'], ['Category', 'category'], ['License', 'license'], ['Deployment', 'deployment'], ['Status', 'status'], ['First released', 'firstReleased'], ['Pricing', 'pricingModel'], ['Scripting languages', 'scriptingLanguages'], ['Protocols', 'protocols']];
    const value = (item, key) => Array.isArray(item[key]) ? item[key].join(', ') : item[key] || 'Not recorded';
    matrix.innerHTML = `<div class="matrix-head"><div>FIELD</div>${data.map((tool) => `<div><strong>${tool.name}</strong><small>${tool.vendor}</small></div>`).join('')}</div>${fields.map(([label, key]) => { const values = data.map((tool) => value(tool, key)); const different = new Set(values).size > 1; return `<div class="matrix-row"><div>${label}</div>${values.map((item) => `<div class="${different ? 'different' : ''}">${item}</div>`).join('')}</div>`; }).join('')}`;
  }
</script>
<style>
  .compare-page { max-width:1100px; margin:0 auto; padding:38px 24px 80px; }.breadcrumbs { display:flex; gap:10px; color:var(--color-surface-300); font-size:11px; margin-bottom:35px; }.breadcrumbs a { color:var(--color-teal-300); }.compare-page h1 { font-size:clamp(42px,8vw,90px); letter-spacing:-.08em; margin:0; }.intro { color:var(--color-surface-300); }.matrix { margin-top:38px; overflow:auto; }.matrix-head,.matrix-row { display:grid; grid-template-columns:170px repeat(var(--compare-columns, 3), minmax(170px,1fr)); min-width:680px; }.matrix-head { border-bottom:1px solid var(--color-teal-700); color:var(--color-teal-300); font:11px var(--font-mono); }.matrix-head > div,.matrix-row > div { padding:15px; border-right:1px solid color-mix(in srgb, var(--color-teal-300) 13%, transparent); }.matrix-head strong,.matrix-head small { display:block; color:var(--color-surface-100); font:600 14px var(--font-sans); }.matrix-head small { color:var(--color-surface-300); font:10px var(--font-mono); margin-top:4px; }.matrix-row { color:var(--color-surface-300); font-size:12px; border-bottom:1px solid color-mix(in srgb, var(--color-teal-300) 13%, transparent); }.matrix-row > div:first-child { color:var(--color-teal-300); font:10px var(--font-mono); text-transform:uppercase; }.matrix-row .different:not(:first-child) { color:var(--color-amber-400); }.empty { margin-top:30px; padding:30px; color:var(--color-surface-300); }
</style>
