---
import ConsoleLayout from '../layouts/ConsoleLayout.astro';
import Directory from '../components/Directory.astro';
import { tools } from '../data/tools';
import {
  datasetSchema,
  organizationSchema,
  toolItemList,
  websiteSchema,
} from '../lib/seo';
import { homeDescription, homeTitle } from '../lib/pageMeta';
---

<ConsoleLayout
  title={homeTitle()}
  description={homeDescription()}
  structuredData={[
    toolItemList(tools),
    websiteSchema(),
    organizationSchema(),
    datasetSchema(),
  ]}
>
  <Directory
    title={`${tools.length} performance testing tools`}
    intro="Compare licenses, protocols, deployment models, and lifecycle status, then shortlist with the Test Rig."
  />
</ConsoleLayout>
