---
interface Props {
  size?: number;
  class?: string;
}

const { size = 34, class: className } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 64 64"
  aria-hidden="true"
  focusable="false"
>
  <rect
    x="1.5"
    y="1.5"
    width="61"
    height="61"
    rx="14"
    fill="#101313"
    stroke="var(--color-teal-700)"
    stroke-width="3"></rect>
  <rect x="12" y="40" width="10" height="12" rx="3" fill="var(--color-teal-700)"
  ></rect>
  <rect x="24" y="32" width="10" height="20" rx="3" fill="var(--color-teal-500)"
  ></rect>
  <rect x="36" y="22" width="10" height="30" rx="3" fill="var(--color-teal-300)"
  ></rect>
  <path
    d="M14 22l12-8 10 5 10-8"
    fill="none"
    stroke="var(--color-amber-400)"
    stroke-width="4"
    stroke-linecap="round"
    stroke-linejoin="round"></path>
</svg>
