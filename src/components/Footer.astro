---
import { ecosystemFooterLinks, llmsTxtHref } from '../lib/organization';
import { siteUrl } from '../lib/urls';
---

<footer class="site-footer panel">
  <nav class="footer-links mono" aria-label="Ecosystem and resources">
    {
      ecosystemFooterLinks.map((link) => (
        <a href={link.href} target="_blank" rel="noreferrer" class="focus-ring">
          {link.label} ↗
        </a>
      ))
    }
    <a href={llmsTxtHref()} class="focus-ring">llms.txt</a>
    <a href={siteUrl('tools.json')} class="focus-ring">tools.json</a>
  </nav>
</footer>

<style>
  .site-footer {
    width: 100%;
    max-width: 100%;
    margin-top: 40px;
    padding: 18px 22px;
    box-sizing: border-box;
  }
  .footer-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 12px 20px;
    font-size: 14px;
    /* Prevent long link rows from clipping against a sticky rail / panel edge */
    min-width: 0;
    max-width: 100%;
  }
  .footer-links a {
    color: var(--color-teal-300);
    text-decoration: none;
    transition: color 0.15s ease;
    white-space: nowrap;
  }
  .footer-links a:hover {
    color: var(--color-amber-400);
  }
</style>
