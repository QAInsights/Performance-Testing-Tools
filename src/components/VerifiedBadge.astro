---
import type { Tool } from '../data/tools';
import { getReview } from '../data/reviews';
import { siteUrl } from '../lib/urls';

let badgeInstance = 0;

const { tool, size = 'sm' } = Astro.props as {
  tool: Tool;
  size?: 'sm' | 'md' | 'lg';
};
const review = getReview(tool.slug);
const iconSize = size === 'lg' ? 40 : size === 'md' ? 22 : 16;
const gradientId = `verified-seal-${tool.slug}-${size}-${badgeInstance++}`;
const rosettePath =
  'M24 2.5l4.2 3.1 5.1-1.2 2.6 4.6 5 1.6.4 5.2 3.9 3.5-2.1 4.8 2.1 4.8-3.9 3.5-.4 5.2-5 1.6-2.6 4.6-5.1-1.2L24 45.5l-4.2-3.1-5.1 1.2-2.6-4.6-5-1.6-.4-5.2-3.9-3.5 2.1-4.8-2.1-4.8 3.9-3.5.4-5.2 5-1.6 2.6-4.6 5.1 1.2z';
---

{
  review && (
    <a
      href={siteUrl(`reviews/${tool.slug}`)}
      class:list={['verified-badge', `verified-badge--${size}`]}
      title={`Curator reviewed · ${review.handsOn ? 'HANDS-ON' : 'DESK REVIEW'} · ${review.reviewedAt}`}
      aria-label="Curator reviewed"
    >
      <svg
        class="verified-seal"
        width={iconSize}
        height={iconSize}
        viewBox="0 0 48 48"
        aria-hidden="true"
      >
        <defs>
          <linearGradient id={gradientId} x1="9" y1="5" x2="38" y2="44">
            <stop offset="0" stop-color="#c6f5ef" />
            <stop offset="0.35" stop-color="#4fd2c7" />
            <stop offset="0.7" stop-color="#10928d" />
            <stop offset="1" stop-color="#005e5c" />
          </linearGradient>
          <radialGradient id={`${gradientId}-sheen`} cx="0.5" cy="0.22" r="0.6">
            <stop offset="0" stop-color="#ffffff" stop-opacity="0.55" />
            <stop offset="0.55" stop-color="#ffffff" stop-opacity="0.12" />
            <stop offset="1" stop-color="#ffffff" stop-opacity="0" />
          </radialGradient>
        </defs>
        <path d={rosettePath} fill={`url(#${gradientId})`} />
        <path d={rosettePath} fill={`url(#${gradientId}-sheen)`} />
        <path
          d={rosettePath}
          fill="none"
          stroke="rgba(255,255,255,.45)"
          stroke-width="0.75"
        />
        <path
          d="M15.5 24.5 21 30l11.5-12"
          fill="none"
          stroke="#04302e"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="4.5"
        />
      </svg>
    </a>
  )
}

<style>
  .verified-badge {
    display: inline-flex;
    line-height: 0;
    vertical-align: -0.15em;
  }
  .verified-badge--lg {
    margin-left: 0.15em;
    vertical-align: middle;
  }
  .verified-seal {
    filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.45))
      drop-shadow(0 0 6px rgba(24, 160, 155, 0.35));
    flex: 0 0 auto;
    transition: transform 0.18s ease;
  }
  .verified-badge:hover .verified-seal {
    transform: scale(1.12);
  }
</style>
