---
import type { Tool } from '../data/tools';
import { getReview } from '../data/reviews';
import VerifiedBadge from './VerifiedBadge.astro';
const { tool } = Astro.props as { tool: Tool };
const reviewed = Boolean(getReview(tool.slug));
---

<span class="badge badge--teal">{tool.category}</span>
<span class="badge badge--cyan">{tool.license}</span>
<span class="badge">{tool.deployment}</span>
{
  reviewed && (
    <span class="badge badge--reviewed" title="Curator review available">
      <VerifiedBadge tool={tool} size="sm" />
      <span>REVIEWED</span>
    </span>
  )
}
{
  tool.personalPick && (
    <span class="badge badge--amber" title="Personal pick">
      ♥ personal pick
    </span>
  )
}
{
  tool.generalPick && (
    <span class="badge badge--cyan" title="General pick">
      ✓ general pick
    </span>
  )
}
<style>
  .badge {
    align-items: center;
    box-sizing: border-box;
    border: 1px solid var(--color-surface-700);
    color: var(--color-surface-300);
    display: inline-flex;
    font: 12px/1.3 var(--font-mono);
    gap: 4px;
    height: 26px;
    margin: 0;
    padding: 0 7px;
    white-space: nowrap;
  }
  .badge--teal {
    color: var(--color-teal-300);
    border-color: var(--color-teal-700);
  }
  .badge--cyan {
    color: var(--color-cyan-500);
    border-color: color-mix(in srgb, var(--color-cyan-500) 60%, transparent);
  }
  .badge--amber {
    color: var(--color-amber-400);
    border-color: var(--color-amber-400);
  }
  .badge--reviewed {
    color: var(--color-teal-300);
    border-color: var(--color-teal-300);
  }
  .badge--reviewed :global(svg) {
    width: 12px;
    height: 12px;
  }
</style>
