---
import type { Tool } from '../data/tools';
import { siteUrl } from '../lib/urls';
import LoadProfile from './LoadProfile.astro';
import ToolBadges from './ToolBadges.astro';
const { tool } = Astro.props as { tool: Tool };
---

<tr
  data-tool={tool.slug}
  data-name={tool.name.toLowerCase()}
  data-vendor={tool.vendor.toLowerCase()}
  data-description={tool.description.toLowerCase()}
  data-tags={tool.tags.join('|').toLowerCase()}
  data-category={tool.category}
  data-license={tool.license}
  data-deployment={tool.deployment}
  data-status={tool.status}
  data-language={tool.scriptingLanguages.join('|')}
  data-protocol={tool.protocols.join('|')}
  data-pick={`${tool.personalPick ? 'personal' : ''}|${tool.generalPick ? 'general' : ''}`}
  data-released={tool.firstReleased ?? ''}
>
  <td
    ><a class="tool-name focus-ring" href={siteUrl(`tools/${tool.slug}`)}
      >{tool.name}</a
    ><span class="tool-vendor">{tool.vendor}</span>{
      tool.status !== 'Active' && <span class="status-dot">{tool.status}</span>
    }</td
  >
  <td class="description-cell">{tool.description}</td>
  <td><ToolBadges tool={tool} /></td>
  <td><LoadProfile tool={tool} /></td>
  <td
    ><label class="compare-check"
      ><input
        type="checkbox"
        data-compare={tool.slug}
        aria-label={`Add ${tool.name} to Test Rig`}
      /><span>+</span></label
    ></td
  >
</tr>
<style>
  td {
    padding: 16px 18px;
    border-bottom: 1px solid
      color-mix(in srgb, var(--color-teal-300) 12%, transparent);
    vertical-align: middle;
    font-size: 15px;
  }
  tr:last-child td {
    border-bottom: 0;
  }
  .tool-name {
    display: block;
    color: var(--color-surface-100);
    font-size: 16px;
    font-weight: 600;
    text-decoration: none;
  }
  .tool-name:hover {
    color: var(--color-amber-400);
  }
  .tool-vendor {
    display: block;
    color: var(--color-surface-300);
    font: 12px var(--font-mono);
    margin-top: 4px;
  }
  .description-cell {
    color: var(--color-surface-300);
    font-size: 15px;
    line-height: 1.5;
    max-width: 380px;
  }
  .status-dot {
    display: inline-block;
    margin-top: 6px;
    color: var(--color-amber-400);
    font: 12px var(--font-mono);
    text-transform: uppercase;
  }
</style>
