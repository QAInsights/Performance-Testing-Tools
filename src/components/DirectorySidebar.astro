---
import { datasetLastVerified, type Category } from '../data/tools';
import { siteUrl } from '../lib/urls';
import Logo from './Logo.astro';

interface Props {
  category?: Category;
  toolsCount: number;
  categoriesCount: number;
  optionGroups: readonly (readonly [string, string[]])[];
}

const { category, toolsCount, categoriesCount, optionGroups } = Astro.props;
---

<aside class="rail panel">
  <a href={siteUrl()} class="brand focus-ring"
    ><Logo class="brand-mark" /><span
      >PERFORMANCE<br /><b>TESTING TOOLS</b></span
    ></a
  >
  <div class="rail-rule"></div>
  <div class="dataset-stats" aria-label="Catalog stats">
    <span class="stat-pill mono">
      <strong>{toolsCount}</strong> tools
    </span>
    <span class="stat-pill mono">
      <strong>{categoriesCount}</strong> categories
    </span>
    <span class="stat-pill stat-pill--muted mono">
      updated {datasetLastVerified}
    </span>
  </div>
  <nav class="rail-nav" aria-label="Primary">
    <a href={siteUrl()} class="active focus-ring">Directory</a>
    <a href={siteUrl('wizard')} class="rail-nav-gradient focus-ring"
      >Tool Finder</a
    >
    <a href={siteUrl('timeline')} class="focus-ring">Timeline</a>
    <a href={siteUrl('health')} class="focus-ring">Repo Health</a>
    <a href={siteUrl('about')} class="focus-ring">About</a>
  </nav>
  <details class="filter-disclosure" open>
    <summary>FILTER SIGNALS</summary>
    <div class="filter-groups">
      {
        optionGroups.map(([key, options]) =>
          key !== 'category' || !category ? (
            key === 'language' || key === 'protocol' ? (
              <details class="sub-filter-disclosure" data-filter-group={key}>
                <summary>{key}</summary>
                <div class="sub-filter-options">
                  {options.map((option) => (
                    <label>
                      <input
                        class="signal-check"
                        type="checkbox"
                        data-filter={key}
                        value={option}
                      />
                      <span>{option}</span>
                    </label>
                  ))}
                </div>
              </details>
            ) : (
              <fieldset class="filter-group" data-filter-group={key}>
                <legend>{key}</legend>
                {options.map((option) => (
                  <label>
                    <input
                      class="signal-check"
                      type="checkbox"
                      data-filter={key}
                      value={option}
                    />
                    <span>{option}</span>
                  </label>
                ))}
              </fieldset>
            )
          ) : null,
        )
      }
      <fieldset class="filter-group">
        <legend>picks</legend>
        <label>
          <input
            class="signal-check"
            type="checkbox"
            data-filter="pick"
            value="personal"
          />
          <span>♥ personal</span>
        </label>
        <label>
          <input
            class="signal-check"
            type="checkbox"
            data-filter="pick"
            value="general"
          />
          <span>✓ general</span>
        </label>
      </fieldset>
    </div>
  </details>
</aside>
