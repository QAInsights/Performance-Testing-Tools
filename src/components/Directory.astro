---
import { tools, type Category } from '../data/tools';
import { FEATURED_SLOT_COUNT } from '../data/sponsors';
import { siteUrl } from '../lib/urls';
import ToolRow from './ToolRow.astro';
import ToolCard from './ToolCard.astro';
import DirectorySidebar from './DirectorySidebar.astro';
import DirectoryControlBar from './DirectoryControlBar.astro';
import CompareTray from './CompareTray.astro';
import CommandPalette from './CommandPalette.astro';
import Footer from './Footer.astro';
import '../styles/directory.css';

interface Props {
  title?: string;
  intro?: string;
  category?: Category;
}

const {
  title = 'Performance Testing Tools',
  intro = 'Instrument your next performance test with a tool that fits the load profile.',
  category,
} = Astro.props;

const visibleTools = category
  ? tools.filter((tool) => tool.category === category)
  : tools;
const showSponsorSlot = !category;
const featuredTools = showSponsorSlot
  ? tools
      .filter((tool) => tool.featured && tool.status === 'Active')
      .slice(0, FEATURED_SLOT_COUNT)
  : [];
const featuredSlots = Array.from(
  { length: FEATURED_SLOT_COUNT },
  (_, index) => featuredTools[index],
);
const categories = [...new Set(tools.map((tool) => tool.category))];
const licenses = [...new Set(tools.map((tool) => tool.license))];
const deployments = [...new Set(tools.map((tool) => tool.deployment))];
const statuses = [...new Set(tools.map((tool) => tool.status))];
const languages = [
  ...new Set(tools.flatMap((tool) => tool.scriptingLanguages)),
].sort();
const protocols = [...new Set(tools.flatMap((tool) => tool.protocols))].sort();
const optionGroups = [
  ['category', categories],
  ['license', licenses],
  ['deployment', deployments],
  ['status', statuses],
  ['language', languages],
  ['protocol', protocols],
] as const;
---

<section
  class="directory-shell"
  data-directory
  data-category={category}
  data-base={siteUrl()}
>
  <DirectorySidebar
    category={category}
    toolsCount={tools.length}
    categoriesCount={categories.length}
    optionGroups={optionGroups}
  />
  <div class="directory-main">
    <header class:list={['topbar', showSponsorSlot && 'topbar--with-sponsor']}>
      <div class="topbar-copy">
        <p class="eyebrow">
          PERFORMANCE TOOLING / {category ? 'CATEGORY VIEW' : 'LIVE DIRECTORY'}
        </p>
        <h1>{title}</h1>
        <p class="intro">{intro}</p>
        {
          !category && (
            <a class="directory-wizard-link mono" href={siteUrl('wizard')}>
              TOOL FINDER →
            </a>
          )
        }
      </div>
      {
        showSponsorSlot && (
          <a
            class="sponsor-slot focus-ring"
            href={siteUrl('sponsors')}
            data-sponsor-cta="topbar"
          >
            <span class="sponsor-slot-label mono">Sponsored</span>
            <span class="sponsor-slot-title">Featured partner slots</span>
          </a>
        )
      }
      <button
        class="icon-button topbar-palette focus-ring"
        type="button"
        data-palette-open
        aria-label="Open command palette">⌘K</button
      >
    </header>
    {
      showSponsorSlot && (
        <section class="featured-slots" aria-labelledby="featured-slots-title">
          <div class="featured-slots-header">
            <p class="eyebrow">SPONSORED / FEATURED PARTNERS</p>
            <h2 id="featured-slots-title">
              {FEATURED_SLOT_COUNT} clearly labeled featured placements
            </h2>
            <p>
              Sponsored listings are separate from directory filters, ranking,
              and curator picks. Open slots are available for vendors who want
              buyer-intent visibility without changing editorial signals.
            </p>
          </div>
          <div class="featured-slot-grid">
            {featuredSlots.map((tool, index) =>
              tool ? (
                <a
                  class="featured-slot panel focus-ring"
                  href={siteUrl(`tools/${tool.slug}`)}
                  rel="sponsored"
                  data-sponsor-slot={index + 1}
                >
                  <span class="featured-slot-label mono">Sponsored</span>
                  <strong>{tool.name}</strong>
                  <small>
                    {tool.vendor} · {tool.status} · {tool.category}
                  </small>
                </a>
              ) : (
                <a
                  class="featured-slot panel focus-ring featured-slot--open"
                  href={siteUrl('sponsors')}
                  data-sponsor-slot={index + 1}
                  data-sponsor-cta="open-slot"
                >
                  <span class="featured-slot-label mono">
                    Sponsored placement
                  </span>
                  <strong>Featured slot {index + 1}</strong>
                  <small>Available · labeled · no ranking changes</small>
                </a>
              ),
            )}
          </div>
        </section>
      )
    }
    <DirectoryControlBar />
    <div class="results-line mono">
      <span data-results-count>{visibleTools.length}</span> signals found <span
        class="live-region"
        aria-live="polite"
        data-announcement></span><button
        type="button"
        data-clear-filters
        class="clear-button">clear filters</button
      >
    </div>
    <div class="table-wrap panel" data-table-wrap>
      <table>
        <caption class="sr-only">Performance testing tools directory</caption>
        <thead
          ><tr
            ><th>TOOL / VENDOR</th><th>DESCRIPTION</th><th>CLASS</th><th
              >LOAD PROFILE</th
            ><th>COMPARE</th></tr
          ></thead
        >
        <tbody data-tool-list>
          {visibleTools.map((tool) => <ToolRow tool={tool} />)}
        </tbody>
      </table>
    </div>
    <div class="card-list" data-card-list>
      {visibleTools.map((tool) => <ToolCard tool={tool} />)}
    </div>
    <div class="empty-state panel" data-empty hidden>
      No tools match this signal set. <button type="button" data-clear-filters
        >Reset filters</button
      >
    </div>
    <Footer />
  </div>
  <CompareTray />
  <CommandPalette />
</section>

<script src="../scripts/directory.ts"></script>
