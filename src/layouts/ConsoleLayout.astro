---
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import EthicalAd from '../components/EthicalAd.astro';
import { resolveEthicalAdsPublisher } from '../lib/ethicalAds';
import { baseUrl } from '../lib/urls';
import { homeDescription, homeTitle } from '../lib/pageMeta';

const {
  title = homeTitle(),
  description = homeDescription(),
  structuredData = [],
  canonical,
  ogImage,
  ogType = 'website',
  markdownHref,
  noIndex = false,
  adKeywords = [],
  showAd = true,
} = Astro.props;

const adPublisher = showAd
  ? resolveEthicalAdsPublisher(import.meta.env.PUBLIC_ETHICALADS_PUBLISHER)
  : null;
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Google tag (gtag.js) -->
    <script
      is:inline
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-12100G3S00"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', 'G-12100G3S00');
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="manifest" href={baseUrl('manifest.webmanifest')} />
    <link rel="icon" href={baseUrl('favicon.svg')} type="image/svg+xml" />
    <Seo
      title={title}
      description={description}
      canonical={canonical}
      ogImage={ogImage}
      ogType={ogType}
      markdownHref={markdownHref}
      structuredData={structuredData}
      noIndex={noIndex}
    />
  </head>
  <body class="console-grid">
    <slot />
    {adPublisher && <EthicalAd publisher={adPublisher} keywords={adKeywords} />}
  </body>
</html>
